#!/bin/sh /etc/rc.common

START=51
STOP=15
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/uhttpd -f \
		-p 192.168.1.1:8090 \
		-h /www/speedtest \
		-I index.html \
		-D \
		-x /cgi-bin \
		-t 60 \
		-T 30 \
		-k 20 \
		-n 3 \
		-N 50
	procd_set_param respawn
	procd_close_instance
}
