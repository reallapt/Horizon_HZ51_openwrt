#!/bin/sh
length="${CONTENT_LENGTH:-0}"
case "$length" in *[!0-9]*|'') length=0;; esac
if [ "$length" -gt 0 ]; then
  dd of=/dev/null bs=65536 count=$(( (length + 65535) / 65536 )) 2>/dev/null
fi
echo 'Status: 200 OK'
echo 'Content-Type: application/json'
echo 'Cache-Control: no-store'
echo
echo "{\"received\":$length}"
